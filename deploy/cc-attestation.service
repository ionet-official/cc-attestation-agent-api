[Unit]
Description=FastAPI Confidential Computing Attestation Service
Documentation=https://github.com/ionet-official/cc-attestation-agent-api
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ionet/cc-attestation-agent-api

# Verify file integrity before starting - fails if files have been tampered with
ExecStartPre=/bin/bash -c 'cd /opt/ionet/cc-attestation-agent-api && sha256sum -c .integrity-checksums'

ExecStart=/opt/ionet/cc-attestation-agent-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 443 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=VLLM_API_KEY=dummy_key

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cc-attestation

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Required access for TDX attestation and application files
ReadWritePaths=/sys/kernel/config/tsm /opt/ionet/cc-attestation-agent-api

# Limit resources (adjust as needed)
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
